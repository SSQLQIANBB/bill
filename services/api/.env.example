APP_ENV=development
APP_NAME=Bill API
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

DATABASE_DRIVER=mysql+aiomysql
DATABASE_URL=
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=bill-mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=bill
MYSQL_USER=bill
MYSQL_PASSWORD=bill_password
MYSQL_ROOT_PASSWORD=bill_root

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://localhost:6379/0

WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_DEV_CODE=123456
